# LateDev Router env example
# Copy to .env and customize

# Server bind
LATEDEV_HOST=0.0.0.0
LATEDEV_PORT=8787

# Persistent data directory (DB, sessions, cache)
LATEDEV_DATA_DIR=./data

# Master encryption key for provider credentials. Setup REQUIRES a master key:
# set it here (or enter it in the setup screen). It is persisted to
# <dataDir>/master.key (mode 0600) after setup; the file is not included in
# backups. When restoring a backup on another host, deploy master.key or set
# this variable to the SAME key, or encrypted credentials cannot be read.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be 32 bytes base64 (44 chars) or a plain 32-character string.
LATEDEV_MASTER_KEY=

# Docker auto-update (compose `updater` profile with Watchtower). The app
# calls this URL to trigger an instant update; keep the token private.
# LATEDEV_WATCHTOWER_URL=http://watchtower:8080
# LATEDEV_WATCHTOWER_TOKEN=change-me

# Trust X-Forwarded-For from this many proxy hops. 0 = never trust forwarded headers.
# Use 1 only when behind a single trusted reverse proxy.
LATEDEV_TRUST_PROXY=0

# Application log level: trace, debug, info, warn, error, fatal
LATEDEV_LOG_LEVEL=info

# --- Request-lifecycle debug logging (docs/13-LOGGING.md) -----------------
# All default off. Enable for one-shot reproduction of a gateway issue, then
# follow with `docker logs -f ldrouter` (or `docker compose logs -f`).
# DEBUG_HTTP=true        # [INCOMING]/[BODY SUMMARY]/[MESSAGES]/[TOOLS]/[MODEL RESOLVE]/[CAPABILITY REJECT]
# DEBUG_HTTP_BODY=true   # full sanitized incoming + upstream JSON bodies
# DEBUG_UPSTREAM=true    # upstream fetch/response/error + nested error.cause
# DEBUG_STREAM=true      # SSE stream lifecycle (start/chunks/end/error/disconnect)
DEBUG_HTTP=false
DEBUG_HTTP_BODY=false
DEBUG_UPSTREAM=false
DEBUG_STREAM=false
