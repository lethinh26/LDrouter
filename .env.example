# LateDev Router env example
# Copy to .env and customize

# Server bind
LATEDEV_HOST=0.0.0.0
LATEDEV_PORT=8787

# Persistent data directory (DB, sessions, cache)
LATEDEV_DATA_DIR=./data

# Master encryption key for provider credentials (required once any provider exists)
# If unset on a fresh data directory, the setup process auto-generates one and stores it
# in <dataDir>/master.key (mode 0600). The master.key file is not included in backups.
# When restoring a backup on another host, either deploy master.key or set LATEDEV_MASTER_KEY.
# Generate manually with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LATEDEV_MASTER_KEY=

# Trust X-Forwarded-For from this many proxy hops. 0 = never trust forwarded headers.
# Use 1 only when behind a single trusted reverse proxy.
LATEDEV_TRUST_PROXY=0

# Application log level: trace, debug, info, warn, error, fatal
LATEDEV_LOG_LEVEL=info
