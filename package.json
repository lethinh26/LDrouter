{
  "name": "ldrouter",
  "version": "1.11.1",
  "description": "LateDev Router — lightweight self-hosted LLM gateway with admin UI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lethinh26/ldrouter.git"
  },
  "homepage": "https://github.com/lethinh26/ldrouter#readme",
  "bugs": {
    "url": "https://github.com/lethinh26/ldrouter/issues"
  },
  "main": "dist/server/app.js",
  "bin": {
    "ldrouter": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "migrations"
  ],
  "keywords": [
    "llm",
    "gateway",
    "router",
    "openai",
    "anthropic",
    "proxy",
    "self-hosted"
  ],
  "scripts": {
    "dev": "node --import tsx/esm scripts/dev.ts",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:server": "tsc -p tsconfig.build.json && node --import tsx/esm scripts/fix-imports.mts",
    "build:web": "vite build",
    "start": "node dist/cli.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx/esm scripts/migrate.ts",
    "migrate": "node --import tsx/esm scripts/migrate.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "release:patch": "pnpm verify && npm version patch -m \"release: v%s\"",
    "release:minor": "pnpm verify && npm version minor -m \"release: v%s\"",
    "release:major": "pnpm verify && npm version major -m \"release: v%s\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "argon2": "^0.43.0",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "execa": "^10.0.1",
    "fastify": "^5.2.1",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.469.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "semver": "^7.8.5",
    "sonner": "^1.7.1",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@types/speakeasy": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.11.0",
    "happy-dom": "^16.5.3",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
